generator client {
  provider = "prisma-client-js"
  output   = "node_modules/@prisma/client/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                      String           @id @default(cuid())
  email                   String           @unique
  name                    String?
  hashedPassword          String?
  role                    String           @default("user")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  transactions            Transaction[]
  assignedServiceRequests ServiceRequest[] @relation("AssignedServiceRequests")
  createdServiceRequests  ServiceRequest[] @relation("CreatedServiceRequests")
  customers               Customer[]
}

model Customer {
  id              String           @id @default(cuid())
  name            String
  email           String?
  phone           String?
  status          String           @default("active")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  transactions    Transaction[]
  serviceRequests ServiceRequest[]
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
}

model ServiceRequest {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          String   @default("open")
  priority        String   @default("medium")
  assignedUserId  String?
  assignedUser    User?    @relation("AssignedServiceRequests", fields: [assignedUserId], references: [id])
  createdByUserId String?
  createdBy       User?    @relation("CreatedServiceRequests", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Transaction {
  id          String    @id @default(cuid())
  amount      Float
  description String
  type        String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
